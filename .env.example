# Copia este fichero como .env y rellénalo. .env NO se sube a git (está en .gitignore).
CENTRO_IA_URL=https://direccion-del-servidor/v1
CENTRO_IA_KEY=tu-clave-personal
CENTRO_IA_MODELO=nombre-del-modelo
# Opcional: certificado propio, solo si el servidor lo necesita
# CENTRO_IA_CA=~/ruta/certificado.crt